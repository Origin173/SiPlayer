{
  "name": "siplayer",
  "version": "0.1.0",
  "private": true,
  "description": "SiPlayer — a quiet, music-first Netease Cloud Music player.",
  "author": "Origin173",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:gateway": "pnpm --filter @siplayer/gateway dev",
    "dev:mobile": "pnpm --filter @siplayer/mobile start",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
