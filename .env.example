# Gateway
PORT=8787
HOST=127.0.0.1
NETEASE_API_BASE_URL=http://127.0.0.1:3000
SESSION_ENCRYPTION_KEY=replace-with-a-long-random-secret
SESSION_TTL_MS=2592000000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Mobile (Expo public values only; never put secrets here)
EXPO_PUBLIC_GATEWAY_URL=http://127.0.0.1:8787

# Put temporary build/cache files on D: when running locally.
TMP=D:\\tmp\\siplayer
